# Google Gemini (required only to generate proposals)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub token: read public/private repository contents; write permissions are
# needed only to create a branch and pull request after explicit approval.
GITHUB_TOKEN=

# Optional WhatsApp notifications (all four values are required to enable).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
USER_WHATSAPP_NUMBER=

# Keep development local and loopback-only by default.
BLUEFIST_ENV=development
BLUEFIST_SANDBOX=docker
BLUEFIST_API_TOKEN=
BLUEFIST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
